# Server
PORT=4000
NODE_ENV=development

# CORS
# Leave empty in local development to allow any origin, or set comma-separated origins.
CORS_ORIGIN=http://localhost:3000
# CLIENT_ORIGIN is also supported as a fallback if CORS_ORIGIN is not set.
CLIENT_ORIGIN=http://localhost:3000

# OpenWeather / Google Places
OPEN_WEATHER_API_KEY=your_openweather_api_key
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# OpenWeather quota guard
# Optional. When set, OpenWeather calls stop after this many tracked calls per server-local day.
OPENWEATHER_DAILY_QUOTA_LIMIT=1000

# Admin auth
ADMIN_PASSWORD=change_me_for_local_admin_login
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret

# Firebase Admin SDK
# Use either inline JSON or a local service account path.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Weather alert check interval in minutes (default: 15)
ALERT_CHECK_INTERVAL_MINUTES=60
